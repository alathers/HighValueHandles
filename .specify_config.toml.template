# Bourbon Image Processor Configuration
# This file is git-ignored and will be created as .specify_config.toml if customized

# Image Processing Settings
image_folder = "."                       # Default folder to scan for images
batch_size = "5"                         # Number of bottles per batch, or "all" to process all
lookahead = 3                           # Peeking images beyond batch to catch multi-angle photos
concurrency = 3                          # Concurrent processing limit

# AI / Model Settings
model = "qwen3-vl:32b"                  # Ollama vision model
interactive = false                     # Enable interactive CLI prompts
include_vendor_images = false           # Search/download vendor reference images

# Ollama Connection
ollama_url = "http://localhost:11434"   # Ollama REST API endpoint

# Output Settings
output_dir = "processed/"               # Directory for processed output files
allow_retry = true                      # Retry failed extractions with automatic

# Debugging
debug = false                           # Enable debug logging and verbose output
